# ---------------------------------------------------------------------------
# TechSelect Website Webhook — push live deals to techselect.blog/sales
# Add these to your bot's .env (the one the TelegramDealAutoPoster reads).
# IMPORTANT: WEBSITE_WEBHOOK_SECRET MUST exactly match the value set on the
# website (.env.local -> WEBSITE_WEBHOOK_SECRET), otherwise the webhook returns 401.
# Use a strong, random secret. Do NOT reuse the placeholder below.
# ---------------------------------------------------------------------------

WEBSITE_WEBHOOK_URL=https://techselect.blog/api/deals
WEBSITE_WEBHOOK_SECRET=CHANGE_ME_to_a_strong_random_secret_must_match_website
